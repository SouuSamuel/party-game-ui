rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function room(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isParticipant(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid))
        && get(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)).data.status != 'left';
    }

    function isHost(roomId) {
      return signedIn() && room(roomId).data.hostUid == request.auth.uid;
    }

    function lobbyStatus(status) {
      return status in ['waiting', 'configuring', 'lobby'];
    }

    function protectedRoomKeysOnly() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'selectedGameId',
        'status',
        'updatedAt',
        'endedAt',
        'hostUid',
        'gameState',
        'gameConfig'
      ]);
    }

    match /roomCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['roomId', 'status', 'createdAt'])
        && lobbyStatus(request.resource.data.status);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['waiting', 'configuring', 'playing', 'finished', 'ended', 'lobby'];
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && lobbyStatus(request.resource.data.status)
        && request.resource.data.maxParticipants <= 12
        && request.resource.data.selectedGameId is string;

      allow read: if isParticipant(roomId) || (signedIn() && lobbyStatus(resource.data.status));

      allow update: if isParticipant(roomId)
        && protectedRoomKeysOnly()
        && request.resource.data.hostUid is string
        && request.resource.data.maxParticipants == resource.data.maxParticipants
        && request.resource.data.code == resource.data.code
        && request.resource.data.status in ['waiting', 'configuring', 'lobby', 'playing', 'finished', 'ended'];

      allow delete: if false;

      match /participants/{uid} {
        allow read: if isParticipant(roomId) || (signedIn() && lobbyStatus(room(roomId).data.status));

        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'isHost', 'status', 'joinedAt', 'lastSeenAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 24
          && request.resource.data.status in ['online', 'offline', 'left'];

        allow update: if signedIn()
          && (uid == request.auth.uid || isHost(roomId))
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['name', 'status', 'lastSeenAt', 'isHost'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 24
          && request.resource.data.status in ['online', 'offline', 'left'];

        allow delete: if false;
      }

      match /privateStates/{uid} {
        allow read: if signedIn() && uid == request.auth.uid && isParticipant(roomId);
        allow create, update: if isParticipant(roomId)
          && request.resource.data.keys().hasOnly(['state', 'updatedAt']);
        allow delete: if false;
      }

      match /actions/{actionId} {
        allow read: if isParticipant(roomId);
        allow create: if isParticipant(roomId)
          && request.resource.data.keys().hasOnly(['uid', 'type', 'sequence', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type is string
          && request.resource.data.sequence is int;
        allow update, delete: if false;
      }
    }
  }
}
