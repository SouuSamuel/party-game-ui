    "expo-linear-gradient": "~15.0.0",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.0",
    "expo-updates": "~29.0.19",
